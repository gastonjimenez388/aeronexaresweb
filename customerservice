<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aeronexares — Customer Service</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  /* ── TOKENS ───────────────────────────────────────────── */
  :root {
    --bg:        #080c12;
    --bg2:       #0d1420;
    --bg3:       #111827;
    --panel:     #0f1c2e;
    --border:    #1a2d45;
    --cyan:      #00c8ff;
    --cyan-dim:  #0097c4;
    --cyan-glow: rgba(0,200,255,0.12);
    --gold:      #f0b429;
    --white:     #f0f4f8;
    --gray:      #6b7a90;
    --gray2:     #3a4a5e;
    --red:       #ff4d6a;
    --green:     #00e896;
    --font-d:    'Orbitron', monospace;
    --font-b:    'Inter', sans-serif;
    --r:         10px;
    --r-lg:      16px;
  }

  /* ── RESET ───────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    background: var(--bg);
    color: var(--white);
    font-family: var(--font-b);
    font-size: 14px;
  }

  /* ── LAYOUT ROOT ─────────────────────────────────────── */
  .app {
    display: grid;
    grid-template-columns: 280px 1fr;
    grid-template-rows: 56px 1fr;
    height: 100vh;
  }

  /* ── TOPBAR ──────────────────────────────────────────── */
  .topbar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
  }
  .topbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .topbar-brand .logo-mark {
    width: 28px; height: 28px;
    border: 2px solid var(--cyan);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 1px;
  }
  .topbar-brand h1 {
    font-family: var(--font-d);
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 2px;
  }
  .topbar-brand span {
    font-family: var(--font-d);
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    opacity: 0.8;
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .user-pill {
    display: none;
    align-items: center;
    gap: 8px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 5px 12px 5px 8px;
    font-size: 12px;
    color: var(--gray);
  }
  .user-pill .avatar {
    width: 22px; height: 22px;
    background: var(--cyan-dim);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px;
    color: var(--bg);
    font-weight: 700;
  }
  .user-pill.visible { display: flex; }
  .btn-logout {
    background: none;
    border: 1px solid var(--border);
    color: var(--gray);
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 11px;
    font-family: var(--font-b);
    display: none;
    transition: border-color .2s, color .2s;
  }
  .btn-logout:hover { border-color: var(--cyan); color: var(--cyan); }
  .btn-logout.visible { display: block; }

  /* ── SIDEBAR ─────────────────────────────────────────── */
  .sidebar {
    background: var(--panel);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 20px 16px;
    gap: 8px;
    overflow-y: auto;
  }
  .sidebar-label {
    font-family: var(--font-d);
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--gray);
    text-transform: uppercase;
    padding: 4px 8px 8px;
  }

  /* ── AGENT CARD ──────────────────────────────────────── */
  .agent-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px;
    cursor: pointer;
    transition: border-color .25s, background .25s;
    position: relative;
    overflow: hidden;
  }
  .agent-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cyan-glow);
    opacity: 0;
    transition: opacity .25s;
  }
  .agent-card:hover::before,
  .agent-card.active::before { opacity: 1; }
  .agent-card.active { border-color: var(--cyan); }
  .agent-card:hover { border-color: var(--cyan-dim); }

  .agent-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .agent-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 14px;
    font-weight: 700;
    position: relative;
    flex-shrink: 0;
  }
  .agent-avatar.seren { background: linear-gradient(135deg, #0f2744, #1a3f6f); color: var(--cyan); border: 2px solid var(--cyan-dim); }
  .agent-avatar.kenji { background: linear-gradient(135deg, #1a1a0f, #3a3010); color: var(--gold); border: 2px solid var(--gold); }

  .status-dot {
    position: absolute;
    bottom: 1px; right: 1px;
    width: 10px; height: 10px;
    border-radius: 50%;
    border: 2px solid var(--bg3);
  }
  .status-dot.online { background: var(--green); }
  .status-dot.busy   { background: var(--gold); }

  .agent-info { flex: 1; min-width: 0; }
  .agent-name {
    font-family: var(--font-d);
    font-size: 12px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 1px;
  }
  .agent-role {
    font-size: 10px;
    color: var(--gray);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .agent-badge {
    font-size: 9px;
    padding: 2px 7px;
    border-radius: 10px;
    letter-spacing: 1px;
    font-family: var(--font-d);
  }
  .badge-seren { background: rgba(0,200,255,.1); color: var(--cyan); border: 1px solid rgba(0,200,255,.2); }
  .badge-kenji { background: rgba(240,180,41,.1); color: var(--gold); border: 1px solid rgba(240,180,41,.2); }

  .agent-stat {
    font-size: 10px;
    color: var(--gray);
    display: flex;
    gap: 12px;
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .agent-stat span { display: flex; align-items: center; gap: 4px; }
  .agent-stat strong { color: var(--white); }

  .sidebar-divider {
    height: 1px;
    background: var(--border);
    margin: 8px 0;
  }

  .info-block {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 12px;
    font-size: 11px;
    color: var(--gray);
    line-height: 1.6;
  }
  .info-block strong { color: var(--cyan); display: block; margin-bottom: 4px; font-family: var(--font-d); font-size: 9px; letter-spacing: 2px; }

  /* ── MAIN AREA ───────────────────────────────────────── */
  .main {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    position: relative;
  }

  /* ── LOGIN OVERLAY ───────────────────────────────────── */
  .login-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8,12,18,0.97);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    backdrop-filter: blur(4px);
  }
  .login-card {
    width: 360px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  .login-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  }
  .login-icon {
    width: 52px; height: 52px;
    margin: 0 auto 20px;
    background: var(--cyan-glow);
    border: 1px solid rgba(0,200,255,.3);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
  }
  .login-title {
    font-family: var(--font-d);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    text-align: center;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }
  .login-sub {
    font-size: 12px;
    color: var(--gray);
    text-align: center;
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .form-row { margin-bottom: 14px; }
  .form-row label {
    display: block;
    font-size: 10px;
    font-family: var(--font-d);
    letter-spacing: 2px;
    color: var(--gray);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .form-row input {
    width: 100%;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 10px 14px;
    color: var(--white);
    font-family: var(--font-b);
    font-size: 14px;
    outline: none;
    transition: border-color .2s;
  }
  .form-row input:focus { border-color: var(--cyan); }
  .form-row input::placeholder { color: var(--gray2); }

  .company-confirm {
    display: none;
    background: rgba(0,200,255,.06);
    border: 1px solid rgba(0,200,255,.2);
    border-radius: var(--r);
    padding: 12px;
    margin-bottom: 14px;
    font-size: 12px;
    color: var(--cyan);
    line-height: 1.5;
  }
  .company-confirm.visible { display: block; }
  .company-confirm .confirm-btns {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .confirm-btns button {
    flex: 1;
    padding: 7px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    font-size: 12px;
    font-family: var(--font-b);
    font-weight: 600;
    transition: opacity .2s;
  }
  .confirm-btns button:hover { opacity: .85; }
  .btn-yes { background: var(--cyan); color: var(--bg); }
  .btn-no  { background: var(--bg3); color: var(--gray); border: 1px solid var(--border) !important; }

  .btn-primary {
    width: 100%;
    background: var(--cyan);
    color: var(--bg);
    border: none;
    border-radius: var(--r);
    padding: 12px;
    font-family: var(--font-d);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: pointer;
    transition: background .2s, transform .1s;
    margin-top: 4px;
  }
  .btn-primary:hover { background: var(--cyan-dim); }
  .btn-primary:active { transform: scale(.98); }

  .login-note {
    text-align: center;
    font-size: 10px;
    color: var(--gray2);
    margin-top: 16px;
    line-height: 1.5;
  }
  .login-note span { color: var(--green); }

  /* ── CHAT HEADER ─────────────────────────────────────── */
  .chat-header {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg2);
  }
  .chat-agent-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 13px;
    font-weight: 700;
    position: relative;
  }
  .chat-agent-avatar.seren { background: linear-gradient(135deg, #0f2744, #1a3f6f); color: var(--cyan); border: 2px solid var(--cyan-dim); }
  .chat-agent-avatar.kenji { background: linear-gradient(135deg, #1a1a0f, #3a3010); color: var(--gold); border: 2px solid var(--gold); }
  .chat-agent-avatar .status-dot { bottom: 0; right: 0; }

  .chat-agent-info { flex: 1; }
  .chat-agent-name {
    font-family: var(--font-d);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
  }
  .chat-agent-status {
    font-size: 11px;
    color: var(--green);
    margin-top: 1px;
  }
  .chat-session-info {
    font-size: 10px;
    color: var(--gray);
    font-family: var(--font-d);
    letter-spacing: 1px;
    text-align: right;
  }

  /* ── MESSAGES ────────────────────────────────────────── */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-behavior: smooth;
  }
  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .msg {
    display: flex;
    gap: 10px;
    max-width: 75%;
    animation: fadeUp .25s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .msg.user { align-self: flex-end; flex-direction: row-reverse; }
  .msg.agent { align-self: flex-start; }

  .msg-avatar {
    width: 30px; height: 30px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .msg-avatar.seren { background: linear-gradient(135deg, #0f2744, #1a3f6f); color: var(--cyan); border: 1px solid var(--cyan-dim); font-family: var(--font-d); }
  .msg-avatar.kenji { background: linear-gradient(135deg, #1a1a0f, #3a3010); color: var(--gold); border: 1px solid var(--gold); font-family: var(--font-d); }
  .msg-avatar.user-av { background: var(--bg3); color: var(--cyan); border: 1px solid var(--border); font-family: var(--font-d); font-size: 10px; }

  .msg-bubble {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 14px;
    line-height: 1.6;
    font-size: 13.5px;
  }
  .msg.user .msg-bubble {
    background: rgba(0,200,255,.08);
    border-color: rgba(0,200,255,.2);
    color: var(--white);
  }
  .msg.agent .msg-bubble { color: var(--white); }

  .msg-meta {
    font-size: 10px;
    color: var(--gray2);
    margin-top: 4px;
    text-align: right;
  }
  .msg.agent .msg-meta { text-align: left; }

  /* Typing indicator */
  .typing-indicator {
    display: none;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
  }
  .typing-indicator.visible { display: flex; }
  .typing-dots {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 16px;
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .typing-dots span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    opacity: .3;
    animation: dot 1.2s infinite;
  }
  .typing-dots span:nth-child(2) { animation-delay: .2s; }
  .typing-dots span:nth-child(3) { animation-delay: .4s; }
  @keyframes dot {
    0%, 80%, 100% { opacity: .3; transform: scale(1); }
    40%           { opacity: 1;  transform: scale(1.15); }
  }

  /* ── INPUT BAR ───────────────────────────────────────── */
  .chat-input-area {
    padding: 16px 20px;
    border-top: 1px solid var(--border);
    background: var(--bg2);
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }
  .chat-input {
    flex: 1;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--white);
    font-family: var(--font-b);
    font-size: 14px;
    outline: none;
    resize: none;
    max-height: 120px;
    line-height: 1.5;
    transition: border-color .2s;
  }
  .chat-input:focus { border-color: var(--cyan); }
  .chat-input::placeholder { color: var(--gray2); }

  .btn-send {
    background: var(--cyan);
    border: none;
    border-radius: 10px;
    width: 42px; height: 42px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background .2s, transform .1s;
    flex-shrink: 0;
  }
  .btn-send:hover { background: var(--cyan-dim); }
  .btn-send:active { transform: scale(.95); }
  .btn-send svg { width: 18px; height: 18px; fill: var(--bg); }

  /* ── WELCOME STATE ───────────────────────────────────── */
  .welcome-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--gray);
    font-size: 13px;
    text-align: center;
    padding: 40px;
  }
  .welcome-state .w-icon {
    font-size: 36px;
    opacity: .4;
    margin-bottom: 8px;
  }
  .welcome-state h3 {
    font-family: var(--font-d);
    font-size: 13px;
    color: var(--gray);
    letter-spacing: 2px;
    font-weight: 400;
  }
  .welcome-agents {
    display: flex;
    gap: 20px;
    margin-top: 16px;
  }
  .welcome-agent-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 16px 20px;
    cursor: pointer;
    transition: border-color .2s;
    text-align: center;
  }
  .welcome-agent-card:hover { border-color: var(--cyan); }
  .welcome-agent-card .wa-avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    margin: 0 auto 10px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 16px;
    font-weight: 700;
  }
  .wa-avatar.seren { background: linear-gradient(135deg, #0f2744, #1a3f6f); color: var(--cyan); border: 2px solid var(--cyan-dim); }
  .wa-avatar.kenji { background: linear-gradient(135deg, #1a1a0f, #3a3010); color: var(--gold); border: 2px solid var(--gold); }
  .welcome-agent-card .wa-name { font-family: var(--font-d); font-size: 12px; color: var(--white); letter-spacing: 1px; }
  .welcome-agent-card .wa-lang { font-size: 10px; color: var(--gray); margin-top: 4px; }

  /* ── RESPONSIVE ──────────────────────────────────────── */
  @media (max-width: 680px) {
    .app { grid-template-columns: 1fr; grid-template-rows: 56px auto 1fr; }
    .sidebar { display: none; }
    .welcome-agents { flex-direction: column; }
  }
</style>
</head>
<body>

<div class="app">

  <!-- TOPBAR -->
  <header class="topbar">
    <div class="topbar-brand">
      <div class="logo-mark">ANX</div>
      <div>
        <h1>AERONEXARES</h1>
        <span>CUSTOMER SERVICE</span>
      </div>
    </div>
    <div class="topbar-right">
      <div class="user-pill" id="userPill">
        <div class="avatar" id="userInitials">--</div>
        <span id="userName">—</span>
      </div>
      <button class="btn-logout" id="btnLogout" onclick="logout()">Salir</button>
    </div>
  </header>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-label">Agentes disponibles</div>

    <div class="agent-card" id="cardSeren" onclick="selectAgent('seren')">
      <div class="agent-header">
        <div class="agent-avatar seren">
          S
          <div class="status-dot online"></div>
        </div>
        <div class="agent-info">
          <div class="agent-name">SEREN</div>
          <div class="agent-role">Customer Relations</div>
        </div>
        <span class="agent-badge badge-seren">EN · ES</span>
      </div>
      <div class="agent-stat">
        <span>⚡ <strong id="serenSessions">0</strong> sesiones hoy</span>
        <span>⏱ <strong id="serenAvg">—</strong> resp.</span>
      </div>
    </div>

    <div class="agent-card" id="cardKenji" onclick="selectAgent('kenji')">
      <div class="agent-header">
        <div class="agent-avatar kenji">
          K
          <div class="status-dot online"></div>
        </div>
        <div class="agent-info">
          <div class="agent-name">KENJI</div>
          <div class="agent-role">Customer Relations</div>
        </div>
        <span class="agent-badge badge-kenji">EN · ES</span>
      </div>
      <div class="agent-stat">
        <span>⚡ <strong id="kenjiSessions">0</strong> sesiones hoy</span>
        <span>⏱ <strong id="kenjiAvg">—</strong> resp.</span>
      </div>
    </div>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">Sistema</div>

    <div class="info-block">
      <strong>AXIOM · ESTADO</strong>
      🟢 Todos los sistemas operativos<br>
      Informe diario ORION: 18:00 hs AR
    </div>

    <div class="info-block" style="margin-top:4px">
      <strong>PRIVACIDAD</strong>
      Tu información se guarda de forma segura y solo se usa para mejorar tu atención. Sin contraseñas.
    </div>
  </aside>

  <!-- MAIN CHAT -->
  <main class="main" id="mainArea">

    <!-- LOGIN OVERLAY -->
    <div class="login-overlay" id="loginOverlay">
      <div class="login-card">
        <div class="login-icon">✦</div>
        <div class="login-title">BIENVENIDO</div>
        <div class="login-sub">Solo necesitamos un dato rápido<br>para recordarte la próxima vez.</div>

        <div class="form-row">
          <label>Nombre</label>
          <input type="text" id="inNombre" placeholder="Carlos" autocomplete="given-name">
        </div>
        <div class="form-row">
          <label>Apellido</label>
          <input type="text" id="inApellido" placeholder="Mendez" autocomplete="family-name">
        </div>
        <div class="form-row">
          <label>Email</label>
          <input type="email" id="inEmail" placeholder="carlos@tuempresa.com" autocomplete="email"
                 oninput="checkDomain(this.value)">
        </div>

        <div class="company-confirm" id="companyConfirm">
          <div id="companyMsg"></div>
          <div class="confirm-btns">
            <button class="btn-yes" onclick="confirmCompany(true)">Sí, es mi empresa</button>
            <button class="btn-no"  onclick="confirmCompany(false)">No, personal</button>
          </div>
        </div>

        <button class="btn-primary" onclick="doLogin()">INICIAR CONVERSACIÓN →</button>
        <div class="login-note">
          <span>✓ Sin contraseña</span> · Tu email es tu identidad.<br>
          Retomamos donde dejaste cada vez que vuelvas.
        </div>
      </div>
    </div>

    <!-- WELCOME (sin agente seleccionado) -->
    <div class="welcome-state" id="welcomeState" style="display:none;">
      <div class="w-icon">⬡</div>
      <h3>SELECCIONÁ UN AGENTE PARA COMENZAR</h3>
      <p style="max-width:320px; line-height:1.7">
        O dejá que el sistema asigne uno automáticamente según disponibilidad.
      </p>
      <div class="welcome-agents">
        <div class="welcome-agent-card" onclick="selectAgent('seren')">
          <div class="wa-avatar seren">S</div>
          <div class="wa-name">SEREN</div>
          <div class="wa-lang">Español · English</div>
        </div>
        <div class="welcome-agent-card" onclick="selectAgent('auto')">
          <div class="wa-avatar" style="background:var(--bg3);color:var(--gray);border:2px solid var(--border);font-size:20px;width:48px;height:48px;border-radius:50%;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;">⚡</div>
          <div class="wa-name" style="color:var(--gray)">AUTO</div>
          <div class="wa-lang">Asignación automática</div>
        </div>
        <div class="welcome-agent-card" onclick="selectAgent('kenji')">
          <div class="wa-avatar kenji">K</div>
          <div class="wa-name">KENJI</div>
          <div class="wa-lang">Español · English</div>
        </div>
      </div>
    </div>

    <!-- CHAT VIEW -->
    <div id="chatView" style="display:none; flex-direction:column; height:100%;">
      <div class="chat-header">
        <div class="chat-agent-avatar seren" id="chatAgentAvatar">
          <span id="chatAgentLetter">S</span>
          <div class="status-dot online"></div>
        </div>
        <div class="chat-agent-info">
          <div class="chat-agent-name" id="chatAgentName">SEREN</div>
          <div class="chat-agent-status" id="chatAgentStatus">● En línea · Aeronexares Customer Service</div>
        </div>
        <div class="chat-session-info" id="sessionInfo">
          SESSION —<br>
          <span id="sessionId" style="color:var(--cyan)">—</span>
        </div>
      </div>

      <div class="chat-messages" id="chatMessages">
        <!-- mensajes dinámicos -->
        <div class="typing-indicator" id="typingIndicator">
          <div class="msg-avatar seren" id="typingAvatar">S</div>
          <div class="typing-dots">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>

      <div class="chat-input-area">
        <textarea class="chat-input" id="chatInput" rows="1"
          placeholder="Escribí tu consulta..."
          onkeydown="handleKey(event)"
          oninput="autoResize(this)"></textarea>
        <button class="btn-send" onclick="sendMessage()">
          <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>

  </main>
</div>

<script>
/* ═══════════════════════════════════════════════════════
   CONFIG
═══════════════════════════════════════════════════════ */
// En producción apunta a tu Flask en i7 o al hosting
const API_BASE = window.location.hostname === 'localhost'
  ? 'http://localhost:5000'
  : 'https://www.aeronexares.com/customerservice/api';

const GENERIC_DOMAINS = [
  'gmail.com','hotmail.com','yahoo.com','outlook.com','icloud.com',
  'live.com','protonmail.com','mail.com','aol.com','msn.com',
  'fibertel.com.ar','speedy.com.ar','ciudad.com.ar','arnet.com.ar',
  'yahoo.com.ar','hotmail.com.ar'
];

/* ═══════════════════════════════════════════════════════
   STATE
═══════════════════════════════════════════════════════ */
let state = {
  user: null,          // { nombre, apellido, email, empresa_id, contacto_id }
  agent: null,         // 'seren' | 'kenji'
  sessionId: null,
  history: [],         // { role, content }
  companyDetected: null,
  companyConfirmed: false,
  sessionCount: { seren: 0, kenji: 0 }
};

/* ═══════════════════════════════════════════════════════
   BOOT
═══════════════════════════════════════════════════════ */
window.addEventListener('DOMContentLoaded', () => {
  const saved = localStorage.getItem('anx_user');
  if (saved) {
    state.user = JSON.parse(saved);
    showLoggedIn();
    autoAssignAgent();
  }
  // Simular stats sidebar
  state.sessionCount.seren = Math.floor(Math.random() * 8) + 2;
  state.sessionCount.kenji = Math.floor(Math.random() * 8) + 2;
  document.getElementById('serenSessions').textContent = state.sessionCount.seren;
  document.getElementById('kenjiSessions').textContent = state.sessionCount.kenji;
  document.getElementById('serenAvg').textContent = '~12s';
  document.getElementById('kenjiAvg').textContent = '~10s';
});

/* ═══════════════════════════════════════════════════════
   LOGIN / DOMINIO
═══════════════════════════════════════════════════════ */
function checkDomain(email) {
  const match = email.match(/@(.+)$/);
  if (!match) { hideCompanyConfirm(); return; }
  const domain = match[1].toLowerCase();
  if (GENERIC_DOMAINS.includes(domain)) { hideCompanyConfirm(); return; }
  // Dominio empresarial detectado
  const company = domain.split('.')[0].toUpperCase();
  state.companyDetected = domain;
  document.getElementById('companyMsg').innerHTML =
    `Veo que tu email es de <strong style="color:var(--cyan)">${domain}</strong>.<br>¿Estás consultando en representación de <strong>${company}</strong>?`;
  document.getElementById('companyConfirm').classList.add('visible');
}

function hideCompanyConfirm() {
  state.companyDetected = null;
  state.companyConfirmed = false;
  document.getElementById('companyConfirm').classList.remove('visible');
}

function confirmCompany(yes) {
  state.companyConfirmed = yes;
  if (!yes) { state.companyDetected = null; }
  document.getElementById('companyConfirm').classList.remove('visible');
  // Visual feedback
  const btn = yes
    ? document.querySelector('.btn-yes')
    : document.querySelector('.btn-no');
  btn.textContent = yes ? '✓ Confirmado' : '✓ Ok, personal';
  setTimeout(() => { btn.textContent = yes ? 'Sí, es mi empresa' : 'No, personal'; }, 1500);
}

async function doLogin() {
  const nombre   = document.getElementById('inNombre').value.trim();
  const apellido = document.getElementById('inApellido').value.trim();
  const email    = document.getElementById('inEmail').value.trim();

  if (!nombre || !email) {
    shake(document.querySelector('.login-card'));
    return;
  }

  state.user = {
    nombre,
    apellido,
    email,
    empresa_dominio: state.companyConfirmed ? state.companyDetected : null,
    empresa_confirmada: state.companyConfirmed
  };

  // Registrar/recuperar perfil en backend
  try {
    const res = await fetch(`${API_BASE}/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(state.user)
    });
    if (res.ok) {
      const data = await res.json();
      state.user.contacto_id = data.contacto_id;
      state.user.empresa_id  = data.empresa_id;
      state.user.returning   = data.returning;
      state.user.empresa_nombre = data.empresa_nombre;
    }
  } catch(e) {
    // Offline mode — continúa igual
    state.user.contacto_id = 'local_' + Date.now();
    state.user.returning = false;
  }

  localStorage.setItem('anx_user', JSON.stringify(state.user));
  showLoggedIn();
  autoAssignAgent();
}

function showLoggedIn() {
  document.getElementById('loginOverlay').style.display = 'none';
  document.getElementById('userPill').classList.add('visible');
  document.getElementById('btnLogout').classList.add('visible');
  const u = state.user;
  document.getElementById('userName').textContent = u.nombre + (u.apellido ? ' ' + u.apellido : '');
  document.getElementById('userInitials').textContent =
    (u.nombre[0] + (u.apellido ? u.apellido[0] : '')).toUpperCase();
  // Mostrar welcome
  document.getElementById('welcomeState').style.display = 'flex';
}

function logout() {
  localStorage.removeItem('anx_user');
  location.reload();
}

/* ═══════════════════════════════════════════════════════
   AGENT SELECTION
═══════════════════════════════════════════════════════ */
function autoAssignAgent() {
  // Round-robin simple
  const agents = ['seren', 'kenji'];
  const idx = (state.sessionCount.seren <= state.sessionCount.kenji) ? 0 : 1;
  selectAgent(agents[idx]);
}

function selectAgent(name) {
  if (name === 'auto') {
    autoAssignAgent();
    return;
  }
  state.agent = name;
  state.sessionId = genSessionId(name);
  state.history = [];

  // Update sidebar cards
  document.querySelectorAll('.agent-card').forEach(c => c.classList.remove('active'));
  document.getElementById('card' + cap(name)).classList.add('active');

  // Update chat header
  const avatar = document.getElementById('chatAgentAvatar');
  avatar.className = 'chat-agent-avatar ' + name;
  document.getElementById('chatAgentLetter').textContent = name[0].toUpperCase();
  document.getElementById('chatAgentName').textContent = name.toUpperCase();
  document.getElementById('sessionId').textContent = state.sessionId;
  document.getElementById('typingAvatar').className = 'msg-avatar ' + name;
  document.getElementById('typingAvatar').textContent = name[0].toUpperCase();

  // Show chat view
  document.getElementById('welcomeState').style.display = 'none';
  const cv = document.getElementById('chatView');
  cv.style.display = 'flex';

  // Clear messages
  const msgs = document.getElementById('chatMessages');
  msgs.innerHTML = `<div class="typing-indicator" id="typingIndicator">
    <div class="msg-avatar ${name}" id="typingAvatar">${name[0].toUpperCase()}</div>
    <div class="typing-dots"><span></span><span></span><span></span></div>
  </div>`;

  // Greeting
  startConversation();
}

async function startConversation() {
  const u = state.user;
  const agent = state.agent;
  showTyping(true);

  // Construir primer mensaje de sistema al backend
  const sysContext = buildSystemContext();
  const greeting = u.returning
    ? `returning_user:${u.nombre}`
    : `new_user:${u.nombre}`;

  try {
    const reply = await callBackend(sysContext, greeting);
    showTyping(false);
    appendMsg('agent', reply);
  } catch(e) {
    showTyping(false);
    const g = u.returning
      ? `¡Hola de nuevo, ${u.nombre}! Soy ${cap(agent)} de Aeronexares. ¿En qué puedo ayudarte hoy?`
      : `¡Hola, ${u.nombre}! Soy ${cap(agent)} de Aeronexares. Es un placer atenderte. ¿Con qué puedo ayudarte?`;
    appendMsg('agent', g);
  }
}

/* ═══════════════════════════════════════════════════════
   MESSAGING
═══════════════════════════════════════════════════════ */
async function sendMessage() {
  const input = document.getElementById('chatInput');
  const text = input.value.trim();
  if (!text) return;

  appendMsg('user', text);
  input.value = '';
  input.style.height = 'auto';
  state.history.push({ role: 'user', content: text });

  showTyping(true);

  try {
    const sysCtx = buildSystemContext();
    const reply = await callBackend(sysCtx, null);
    showTyping(false);
    appendMsg('agent', reply);
    state.history.push({ role: 'assistant', content: reply });
  } catch(e) {
    showTyping(false);
    appendMsg('agent', 'Disculpá, tuve un problema de conexión. ¿Podés repetir tu consulta?');
  }
}

async function callBackend(systemContext, overrideUserMsg) {
  const messages = overrideUserMsg
    ? [{ role: 'user', content: overrideUserMsg }]
    : state.history;

  const res = await fetch(`${API_BASE}/chat`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      session_id:  state.sessionId,
      agent:       state.agent,
      contacto_id: state.user?.contacto_id,
      empresa_id:  state.user?.empresa_id,
      system:      systemContext,
      messages:    messages
    })
  });
  if (!res.ok) throw new Error('API error');
  const data = await res.json();
  return data.reply;
}

function buildSystemContext() {
  const u = state.user;
  const agent = state.agent;
  return [
    `Sos ${cap(agent)}, agente de customer service de Aeronexares.`,
    `Atendés en español e inglés con fluidez.`,
    `El cliente se llama ${u.nombre} ${u.apellido || ''}.`,
    u.empresa_id ? `Pertenece a la empresa: ${u.empresa_nombre || u.empresa_id}.` : '',
    u.returning  ? `Ya tiene historial con Aeronexares — retomá el trato desde donde quedó.` : `Es un primer contacto — sé amable, breve y relevá sus necesidades gradualmente.`,
    `Tu objetivo es entender qué necesita el cliente y clasificar su consulta.`,
    `Nunca inventes información técnica sobre productos. Si no sabés algo, decís que vas a consultar al equipo.`,
    `Mantené respuestas cortas (máximo 3-4 líneas) y conversacionales.`
  ].filter(Boolean).join(' ');
}

/* ═══════════════════════════════════════════════════════
   UI HELPERS
═══════════════════════════════════════════════════════ */
function appendMsg(role, text) {
  const msgs = document.getElementById('chatMessages');
  const typing = document.getElementById('typingIndicator');
  const agent = state.agent;
  const now = new Date().toLocaleTimeString('es-AR', { hour:'2-digit', minute:'2-digit' });

  const div = document.createElement('div');
  div.className = `msg ${role}`;

  if (role === 'agent') {
    div.innerHTML = `
      <div class="msg-avatar ${agent}">${agent[0].toUpperCase()}</div>
      <div>
        <div class="msg-bubble">${escHtml(text)}</div>
        <div class="msg-meta">${cap(agent)} · ${now}</div>
      </div>`;
  } else {
    const u = state.user;
    const initials = (u.nombre[0] + (u.apellido ? u.apellido[0] : '')).toUpperCase();
    div.innerHTML = `
      <div class="msg-avatar user-av">${initials}</div>
      <div>
        <div class="msg-bubble">${escHtml(text)}</div>
        <div class="msg-meta">${now}</div>
      </div>`;
  }

  msgs.insertBefore(div, typing);
  msgs.scrollTop = msgs.scrollHeight;
}

function showTyping(show) {
  const t = document.getElementById('typingIndicator');
  t.className = 'typing-indicator' + (show ? ' visible' : '');
  if (show) {
    document.getElementById('chatMessages').scrollTop = 99999;
  }
}

function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}

function genSessionId(agent) {
  const d = new Date();
  const stamp = d.getFullYear().toString().slice(2) +
    String(d.getMonth()+1).padStart(2,'0') +
    String(d.getDate()).padStart(2,'0');
  return (agent === 'seren' ? 'SR' : 'KJ') + '-' + stamp + '-' +
    Math.floor(Math.random()*9000+1000);
}

function cap(s) { return s ? s[0].toUpperCase() + s.slice(1) : ''; }

function escHtml(t) {
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
          .replace(/\n/g,'<br>');
}

function shake(el) {
  el.style.animation = 'none';
  el.offsetHeight;
  el.style.animation = 'shake .4s ease';
}
</script>

<style>
@keyframes shake {
  0%,100% { transform: translateX(0); }
  20%      { transform: translateX(-8px); }
  40%      { transform: translateX(8px); }
  60%      { transform: translateX(-6px); }
  80%      { transform: translateX(6px); }
}
</style>

</body>
</html>
